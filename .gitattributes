# Windows needs CRLF line endings in .bat files, and Linux needs LF in shell scripts.
*.bat text eol=crlf
*.sh text eol=lf
*.java text eol=lf
*.md text eol=lf
*.png binary
*.ttf binary
# An edge-case test program that must keep its Windows line endings and tabs.
src/test/resources/edge/CrlfAndTabs.java -text
